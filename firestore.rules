rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // TEST MODE: anyone can read and write every document until the date below.
    // Replace these with proper per-user rules before going live.
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 11, 11);
    }
  }
}
