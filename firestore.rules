rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // a user can read and write only their own document, which holds exactly
    // their id and codename (never an email)
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['id', 'codename'])
        && request.resource.data.keys().hasAll(['id', 'codename'])
        && request.resource.data.id == request.auth.uid
        && request.resource.data.codename is string;
    }
  }
}
